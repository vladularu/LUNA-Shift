{
  "expo": {
    "name": "LUNA Shift",
    "slug": "pflegeshift",
    "description": "Lokaler Dienstplaner mit Arbeitszeit- und TVöD-P-Auswertung.",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pflegeshift",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "icon": {
        "light": "./assets/brand/lunashift/app-icon-user.png",
        "dark": "./assets/brand/lunashift/app-icon-user.png",
        "tinted": "./assets/brand/lunashift/app-icon-user.png"
      },
      "bundleIdentifier": "com.lunashift.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "allowBackup": false,
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2E766F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pflegeshift.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Wähle ein eigenes Bild für deinen Kalender.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/lunashift/app-icon-user.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F4F5",
          "dark": {
            "image": "./assets/brand/lunashift/app-icon-user.png",
            "backgroundColor": "#09090B"
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "./plugins/with-native-tab-transitions",
      "./plugins/with-local-notifications-only",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "LUNAShiftCalendar",
              "displayName": "Kalender",
              "description": "6 Tage, 2 Wochen oder 4 Wochen mit deinem LUNA-Kalenderdesign.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium", "systemLarge"]
              }
            },
            {
              "name": "LUNAShiftMonth",
              "displayName": "Dieser Monat",
              "description": "Dein aktueller Monat mit farbigen Dienstpunkten.",
              "ios": {
                "supportedFamilies": ["systemSmall"]
              }
            }
          ]
        }
      ],
      "./plugins/with-native-calendar-widget",
      "expo-apple-authentication",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "010fe78f-de53-42b8-9635-a73ea099b5fc"
      }
    },
    "owner": "vladularu",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/010fe78f-de53-42b8-9635-a73ea099b5fc"
    }
  }
}
