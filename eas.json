{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "design": {
      "distribution": "internal",
      "autoIncrement": true,
      "environment": "preview",
      "env": {
        "APP_VARIANT": "design",
        "LUNA_DESIGN_SANDBOX": "1"
      },
      "ios": {
        "simulator": false
      },
      "channel": "design-shadcn"
    },
    "e2e-test": {
      "distribution": "internal",
      "withoutCredentials": true,
      "env": {
        "APP_VARIANT": "internal"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "channel": "e2e-test"
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "environment": "preview",
      "env": {
        "APP_VARIANT": "internal"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false,
        "env": {
          "LUNA_FULL_ENGINE": "1",
          "LUNA_IOS_TARGETS": "aarch64-apple-ios",
          "EXPO_PUBLIC_RUST_MONTH_TRIAL": "1",
          "EXPO_PUBLIC_RUST_NET_BRIDGE": "1",
          "EXPO_PUBLIC_RUST_ANNUAL_BRIDGE": "1",
          "EXPO_PUBLIC_RUST_CHECKS_BRIDGE": "1",
          "EXPO_PUBLIC_RUST_SALARY_PREPARATION": "1"
        }
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "APP_VARIANT": "production"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false,
        "env": {
          "LUNA_FULL_ENGINE": "1",
          "LUNA_IOS_TARGETS": "aarch64-apple-ios",
          "EXPO_PUBLIC_RUST_MONTH_TRIAL": "1",
          "EXPO_PUBLIC_RUST_NET_BRIDGE": "1",
          "EXPO_PUBLIC_RUST_ANNUAL_BRIDGE": "1",
          "EXPO_PUBLIC_RUST_CHECKS_BRIDGE": "1",
          "EXPO_PUBLIC_RUST_SALARY_PREPARATION": "1"
        }
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6811463563"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
