    "sprefix",
    "sconst {UserFacingError,ConcurrencyError,userFacingErrorMessage}=require('../../domain/errors.ts');let existing,savingRef,events,writes,queue,saving;const copy=v=>JSON.parse(JSON.stringify(v));function setSaving(value){saving=value;events.push({kind:'SAVING',value})}function setError(value){events.push({kind:'ERROR',value})}function onDeletionChange(value){events.push({kind:'DELETION_CHANGE',value:copy(value)})}function deletionFeedback(){events.push({kind:'DELETION_FEEDBACK'})}function warningFeedback(){events.push({kind:'WARNING_FEEDBACK'})}function setExit(value){events.push({kind:'EXIT',value})}function removeEntry(value){writes.push(copy(value));return new Promise((resolve,reject)=>{queue={resolve,reject}})}\n",
    "ssuffix",
    "s\nmodule.exports=async function(input){existing=input.existing;savingRef={current:input.busy};saving=input.busy;events=[];writes=[];queue=null;const task=deleteEntry();await Promise.resolve();const begin=copy({events,writes,saving,savingRef:savingRef.current});if(queue){if(input.failureKind==='SUCCESS')queue.resolve();else queue.reject(input.failureKind==='USER_FACING'?new UserFacingError(input.message):input.failureKind==='CONCURRENCY'?new ConcurrencyError():input.failureKind==='NON_ERROR'?{private:'not an Error'}:new Error(input.message));}await task;return {begin,completion:copy({events:events.slice(begin.events.length),saving,savingRef:savingRef.current}),fullEvents:copy(events),writes:copy(writes)}};",
