    "supsertTemplate",
    "sasync (input: SaveShiftTemplateInput) => {\n      const saved = await repository.saveTemplate(input);\n      setTemplates((current) =>\n        replaceById(current, saved)\n          .filter((template) => template.deletedAt === null)\n          .sort((left, right) => left.sortOrder - right.sortOrder),\n      );\n      setEntries((current) =>\n        Object.freeze(\n          current.map((entry) =>\n            entry.kind === \"SHIFT\" && entry.templateId === saved.id\n              ? Object.freeze({\n                  ...entry,\n                  title: saved.name,\n                  color: saved.color,\n                  symbol: saved.symbol,\n                })\n              : entry,\n          ),\n        ),\n      );\n      return saved;\n    }",
    "sremoveTemplate",
    "sasync (template: ShiftTemplate) => {\n      await repository.deleteTemplate(template.id, template.revision);\n      setTemplates((current) => current.filter((item) => item.id !== template.id));\n    }",
