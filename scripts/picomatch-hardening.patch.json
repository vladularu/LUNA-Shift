    {
      "before": "const normalizeSimpleBranch = branch => {",
      "after": "const branchContainsGlobStar = (branch, options) => {\n  let escaped = false;\n  let bracket = false;\n  let quoted = false;\n\n  for (let i = 0; i < branch.length; i++) {\n    const ch = branch[i];\n    if (escaped) {\n      escaped = false;\n      continue;\n    }\n    if (ch === '\\\\') {\n      escaped = true;\n      continue;\n    }\n    if (bracket) {\n      if (ch === ']') bracket = false;\n      continue;\n    }\n    if (ch === '\"') {\n      quoted = !quoted;\n      continue;\n    }\n    if (quoted) continue;\n    if (ch === '[' && options.nobracket !== true && branch.includes(']', i + 1)) {\n      bracket = true;\n      continue;\n    }\n    if (ch === '*' && branch[i + 1] !== '(') return true;\n  }\n  return false;\n};\n\nconst hasBranchRepetitionOverlap = branches => {\n  const values = branches.map(normalizeSimpleBranch).filter(Boolean);\n  for (let i = 0; i < values.length; i++) {\n    for (let j = i + 1; j < values.length; j++) {\n      const a = values[i];\n      const b = values[j];\n      const [short, long] = a.length <= b.length ? [a, b] : [b, a];\n      if (short.length > 0 && long.length % short.length === 0\n        && long === short.repeat(long.length / short.length)) return true;\n    }\n  }\n  return false;\n};\n\nconst normalizeSimpleBranch = branch => {"
    },
